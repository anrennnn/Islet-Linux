{
  "name": "islet",
  "productName": "Islet",
  "version": "0.1.0",
  "description": "Isla dinámica para Linux con controles multimedia (MPRIS)",
  "author": "Anthony <seoconanthony@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/anrennnn/Islet-Linux",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV=1 electron .\"",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder --linux",
    "dist:appimage": "npm run build && electron-builder --linux AppImage",
    "dist:deb": "npm run build && electron-builder --linux deb",
    "dist:rpm": "npm run build && electron-builder --linux rpm",
    "dist:pacman": "npm run build && electron-builder --linux pacman"
  },
  "dependencies": {
    "dbus-next": "^0.10.2"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "io.github.anrennnn.islet",
    "productName": "Islet",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "linux": {
      "category": "Utility",
      "icon": "build/icon.png",
      "executableName": "islet",
      "synopsis": "Isla dinámica con controles multimedia",
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "pacman",
        "tar.gz"
      ]
    },
    "deb": {
      "depends": [
        "libnotify4",
        "libxtst6",
        "libnss3"
      ]
    },
    "rpm": {
      "depends": [
        "libnotify",
        "libXtst",
        "nss"
      ]
    },
    "publish": null,
    "artifactName": "${name}-${version}-${arch}.${ext}"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/anrennnn/Islet-Linux.git"
  }
}
